{
  "expo": {
    "name": "Invoice Pro",
    "slug": "invoice-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "invoicepro",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orvine.invoice",
      "associatedDomains": [
        "applinks:invoice.orvine.in"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.orvine.invoice",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "invoice.orvine.in",
              "pathPrefix": "/app/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "shortName": "InvoicePro",
      "name": "Invoice Pro App",
      "themeColor": "#4f46e5",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Invoice Pro to use the camera to scan product barcodes and capture bills."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Orvine Invoice to access your photos so you can choose a profile picture.",
          "cameraPermission": "Allow Orvine Invoice to use the camera to take a profile picture or capture bills."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Invoice Pro to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4f46e5"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "548fa529-b1e8-4f50-8cb6-6cc5d6e151b9"
      }
    },
    "owner": "yashrasniya"
  }
}
