# Copy to .env for local development. Release builds get their values from eas.json instead.
# Backend root (the app appends /api/). Use your machine's LAN IP when testing on a phone.
EXPO_PUBLIC_API_URL=http://192.168.1.106:8000
# Web app root, used to hand payments off to the browser. The web app is served under /app.
EXPO_PUBLIC_WEB_URL=http://localhost:5173/app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
