# Copy to .env and fill in. `.env` is gitignored; this template is not.
#
# Every DJANGO_* setting defaults to the SAFE value when unset, so a missing
# variable degrades to "locked down" rather than "wide open". The practical
# consequence: LOCAL DEVELOPMENT NEEDS DJANGO_DEBUG=True, otherwise secure-only
# cookies are enforced and you cannot log in over http://localhost.

# ── Core ───────────────────────────────────────────────────────────────
# True only on a developer machine. Never on a deployed host: the debug page
# renders settings, SQL and stack traces to anyone who triggers an error.
DJANGO_DEBUG=True

# Signs session cookies AND every JWT. A leaked key lets anyone forge a login
# as any user, so this must not be the value committed in settings.py.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it logs every user out exactly once.
DJANGO_SECRET_KEY=

# Comma-separated, no scheme.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, WITH scheme (Django 4+ requires it). Missing entries cause:
#   "Origin checking failed - <origin> does not match any trusted origins"
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Comma-separated, with scheme. Only these origins may call the API with
# credentials. Allow-all is confined to DEBUG because combining it with
# CORS_ALLOW_CREDENTIALS lets any site read authenticated responses.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Defaults to "not DEBUG". Only override to force cookies over plain HTTP.
# DJANGO_SECURE_COOKIES=False

# ── Production values, for reference ───────────────────────────────────
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<64 random chars, different from every other environment>
# DJANGO_ALLOWED_HOSTS=invoice.orvine.in
# DJANGO_CSRF_TRUSTED_ORIGINS=https://invoice.orvine.in
# DJANGO_CORS_ALLOWED_ORIGINS=https://invoice.orvine.in

# ── Razorpay ───────────────────────────────────────────────────────────
# key_id is publishable (the API hands it to the browser); key_secret is not.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks. Without it the webhook endpoint rejects
# EVERY request, so subscriptions are never activated and paid customers stay
# on Free. Verify with:  python manage.py verify_razorpay
RAZORPAY_WEBHOOK_SECRET=

# ── Other ──────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
# Extra accepted audiences, comma-separated (the mobile app's *web* client ID if it is in another project).
GOOGLE_OAUTH_EXTRA_CLIENT_IDS=
# Firebase project id (project_id in MobileApp/google-services.json); enables /phone-login/.
FIREBASE_PROJECT_ID=
FRONTEND_URL=http://localhost:5173

# STATIC_ROOT=
# MEDIA_ROOT=

# Set only when served through a reverse proxy / dev tunnel that mounts the
# app under a path prefix (e.g. a hosted preview URL at https://host/app/...).
# Without it, absolute links to uploaded media (line-item images, company
# logo, etc.) come back missing that prefix and 404 through the tunnel.
# PUBLIC_URL_PREFIX=/app

# ── Database ───────────────────────────────────────────────────────────
# Leave DB_NAME unset to use the local db.sqlite3. Set it to use PostgreSQL.
# DB_NAME=invoice_db
# DB_USER=invoice_user
# DB_PASSWORD=...
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Who is emailed when someone asks to delete their account (comma-separated). Defaults to EMAIL_USER.
ACCOUNT_DELETION_NOTIFY_EMAILS=
